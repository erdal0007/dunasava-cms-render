# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Local Admin Login ──────────────────────────────────────────
ADMIN_EMAIL=              # Email used to login to /login
ADMIN_PASSWORD=           # Password used to login to /login
SESSION_SECRET=           # Random 32+ byte string used to sign admin sessions (openssl rand -hex 32)

# ── AI Translation ─────────────────────────────────────────────
OPENAI_API_KEY=          # Required for automatic TR -> EN/SR translations
OPENAI_MODEL=gpt-4.1-mini

# ── Uploads / CORS (optional) ──────────────────────────────────
UPLOADS_DIR=              # Upload directory (production default: /var/data/uploads)
UPLOADS_ORIGIN=           # Origin to proxy missing /uploads/* files from
CORS_ORIGINS=             # Extra comma-separated origins allowed to call /api
